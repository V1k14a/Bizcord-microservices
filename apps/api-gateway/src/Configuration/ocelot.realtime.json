{
  "Routes": [
    {
      "DownstreamPathTemplate": "/calls",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "realtime-microservice",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/realtime-microservice/calls",
      "UpstreamHttpMethod": [ "Post", "Get" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      }
      
    },
    {
      "DownstreamPathTemplate": "/calls/{callId}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "realtime-microservice",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/realtime-microservice/calls/{callId}",
      "UpstreamHttpMethod": [ "Get", "Put", "Delete" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      },
      "AddHeadersToRequest": {
        "X-UserId": "Claims[name] > value"
      }
    },
    {
      "DownstreamPathTemplate": "/calls/{callId}/participants",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "realtime-microservice",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/realtime-microservice/calls/{callId}/participants",
      "UpstreamHttpMethod": [ "Post" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      },
      "AddHeadersToRequest": { "X-UserId": "Claims[name] > value" }
    },
    {
      "DownstreamPathTemplate": "/calls/{callId}/participants/{userId}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "realtime-microservice",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/realtime-microservice/calls/{callId}/participants/{userId}",
      "UpstreamHttpMethod": [ "Delete" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      },
      "AddHeadersToRequest": { "X-UserId": "Claims[name] > value" }
    },
    {
      "DownstreamPathTemplate": "/calls/{callId}/participants/{userId}/mute",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "realtime-microservice",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/realtime-microservice/calls/{callId}/participants/{userId}/mute",
      "UpstreamHttpMethod": [ "Patch" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      },
      "AddHeadersToRequest": { "X-UserId": "Claims[name] > value" }
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:8080"
  }
}
